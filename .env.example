# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR HYDRAULIC COURSE PLATFORM
# Copy this file to .env: `cp .env.example .env`
# Never commit .env into version control.
# ==============================================================================

# Runtime environment (development | test | production)
NODE_ENV=development
PORT=4000

# Base URLs (Used for CORS, redirects, and cookie domain scoping)
# For localhost: APP_URL=http://localhost:3000, API_URL=http://localhost:4000
# For production: APP_URL=https://course.example.com, API_URL=https://api.course.example.com
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database Connection (PostgreSQL 15+)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mycourse?schema=public

# Redis Connection (Used for BullMQ queues, rate limiting, and playback heartbeats)
# Format: redis://<host>:<port> or redis://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6380

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Access Token Secret: generate with `openssl rand -base64 32`
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_32_access_secret_min_32_chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Cookie configuration
# In local dev: leave empty so cookies are strictly host-only (RFC 6265, no Domain attribute sent)
# In production with subdomains: set to .yourdomain.com (so cookies are shared between api. and app.)
COOKIE_DOMAIN=

# Allowed CORS origins (comma-separated if multiple)
CORS_ORIGINS=http://localhost:3000

# AES-256-GCM Encryption Key for TOTP secrets at rest: generate with `openssl rand -hex 32`
TOTP_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32_totp_key_min_32_chars

# Initial Admin User Seed (Used ONLY for first-time database bootstrap)
# Admin password must be at least 12 characters with mixed case, numbers, and symbols.
# Seed script will reject weak passwords and refuse to seed fake data in production.
ADMIN_EMAIL=admin@hydrauliccourse.com
ADMIN_PASSWORD=ChangeMeInProd!2026Hydraulics
ADMIN_NAME=Admin User

# ------------------------------------------------------------------------------
# PAYMENTS (Razorpay)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard -> Settings -> API Keys (Use test keys rzp_test_ for dev)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
# Webhook secret: generate with `openssl rand -hex 24` and set both here and in Razorpay webhook settings
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret_hex

# ------------------------------------------------------------------------------
# VIDEO DELIVERY (Bunny Stream)
# ------------------------------------------------------------------------------
# Video provider implementation: 'fake' for local dev/testing without Bunny account, 'bunny' for production
VIDEO_PROVIDER=fake

# Obtain from Bunny.net -> Stream -> API -> API Key (Full Access - used for uploads & management)
BUNNY_STREAM_API_KEY=placeholder_bunny_api_key
# Obtain from Bunny.net -> Stream -> API -> Read-Only API Key (Used to verify webhook HMAC-SHA256 signatures)
BUNNY_STREAM_READ_ONLY_API_KEY=placeholder_bunny_read_only_api_key
BUNNY_STREAM_LIBRARY_ID=placeholder_bunny_library_id
# Token Authentication Key from Bunny Stream -> Security -> Token Authentication
BUNNY_STREAM_TOKEN_AUTH_KEY=placeholder_bunny_token_auth_key
# Optional explicit Webhook Secret (if configured in Bunny Stream -> Webhooks; falls back to Read-Only key)
BUNNY_STREAM_WEBHOOK_SECRET=
BUNNY_STREAM_CDN_HOSTNAME=video.hydrauliccourse.com

# Concurrent Playback Session Limit per account
MAX_CONCURRENT_STREAMS=2

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Resend / AWS SES / Console)
# ------------------------------------------------------------------------------
# In development: use 'console' (logs emails to stdout)
# In production: use 'resend' or 'ses'
EMAIL_PROVIDER=console
EMAIL_API_KEY=placeholder_email_api_key
EMAIL_FROM=support@hydrauliccourse.com

# ------------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Google OAuth (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry Error Monitoring DSN (Leave blank in local development)
SENTRY_DSN=

# Cloudflare Turnstile CAPTCHA (Optional bot protection for auth endpoints)
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# INVOICE & GST CONFIGURATION (Config-driven, defaults to 0% until CA confirms)
# ------------------------------------------------------------------------------
BUSINESS_NAME=Hydraulic Engineering Academy
BUSINESS_ADDRESS=123 Industrial Area, Phase 2, New Delhi, India
GSTIN=
GST_RATE_PERCENT=0
PRICES_TAX_INCLUSIVE=true
